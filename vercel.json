{
  "cleanUrls": true,
  "buildCommand": "cd projectdashboardv1 && npm install && npm run build",
  "outputDirectory": "projectdashboardv1/dist",
  "installCommand": "echo 'deps installed in buildCommand'",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    { "source": "/api/integrations/webhooks/:connector", "destination": "/api/integrations/webhook?connector=:connector" }
  ]
}
