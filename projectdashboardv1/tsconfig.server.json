{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"]
  },
  "include": [
    "../server/hook-core.ts",
    "../server/health-ingest-core.ts",
    "../server/entry-score.ts",
    "../server/sync-core.ts",
    "../server/sync-store.ts",
    "../server/sync-router.ts",
    "../api/health.ts",
    "../api/health/ingest.ts",
    "../api/hooks.ts",
    "../api/sync/**/*.ts",
    "../server/inbound-note.ts",
    "../server/lifeos-webhook-core.ts",
    "../server/lifeos-merge.ts",
    "src/lib/bodyMeasurement.ts",
    "src/lib/lifeos/areas.ts",
    "src/lib/lifeos/types.ts",
    "src/lib/lifeos/store.ts",
    "src/lib/lifeos/domain.ts",
    "src/lib/lifeos/connectors.ts",
    "src/lib/lifeos/index.ts",
    "src/lib/lifeos/dashboardBridge.ts"
  ]
}
