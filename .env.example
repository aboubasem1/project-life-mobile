# Public entry point. Keep :80 for the first IP-only test; use a hostname for HTTPS/PWA.
LIFEOS_SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443

# PostgreSQL. Generate a unique password on the VPS; never commit the real value.
POSTGRES_USER=lifeos
POSTGRES_PASSWORD=
POSTGRES_DB=lifeos

# Cloudflare R2. The bucket remains private.
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=lifeos-production
R2_REGION=auto

# Temporary Vercel/Upstash compatibility bridge. Disable only after the final cutover.
SYNC_UPSTASH_BRIDGE=true
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Existing server-side AI/transcription integrations.
OPENAI_API_KEY=
LLM_API_KEY=
LLM_API_URL=
LLM_MODEL=
LLM_TIMEOUT_MS=4000
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_API_URL=
TRANSCRIPTION_ENABLED=
TRANSCRIPTION_LANGUAGE=de
TRANSCRIPTION_MODEL=whisper-1
TRANSCRIPTION_TIMEOUT_MS=25000
JEV_API_KEY=
TYPESAFE_API_KEY=
JEV_API_URL=
JEV_MODEL=
JEV_ENABLED=false
JEV_AUTO_ACTIONS_ENABLED=false
JEV_LLM_FALLBACK_ENABLED=false
JEV_TIMEOUT_MS=2500

# Public build-time feature flags. These contain no credentials.
VITE_JEV_ENABLED=false
VITE_JEV_AUTO_ACTIONS_ENABLED=false

# Existing LifeOS developer console.
DEV_ADMIN_SECRET=
GITHUB_ADMIN_TOKEN=

# Daily compressed PostgreSQL dumps to R2.
BACKUP_CRON=15 3 * * *
BACKUP_RUN_ON_START=false
