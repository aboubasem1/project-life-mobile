# Public entry point. Keep :80 for the first IP-only test; use a hostname for HTTPS/PWA.
LIFEOS_SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443

# PostgreSQL. Generate a unique password on the VPS; never commit the real value.
POSTGRES_USER=lifeos
POSTGRES_PASSWORD=
POSTGRES_DB=lifeos

# Cloudflare R2. The bucket remains private.
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=lifeos-production
R2_REGION=auto

# Durable OVH fallback used until R2 credentials are connected.
LOCAL_OBJECT_STORAGE_ROOT=/data/object-storage
OBJECT_STORAGE_SIGNING_SECRET=

# Temporary Vercel/Upstash compatibility bridge. Disable only after the final cutover.
SYNC_UPSTASH_BRIDGE=true
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Existing server-side AI/transcription integrations.
OPENAI_API_KEY=
LLM_API_KEY=
LLM_API_URL=
LLM_MODEL=
LLM_TIMEOUT_MS=4000
# DeepInfra (server-only). Never commit the real key. Prefer a dedicated LifeOS API key + DeepInfra key spending limit.
DEEPINFRA_API_KEY=
DEEPINFRA_ENABLED=true
DEEPINFRA_TRANSCRIPTION_ENABLED=true
DEEPINFRA_TRANSCRIPTION_URL=https://api.deepinfra.com/v1/inference/openai/whisper-large-v3-turbo
DEEPINFRA_TRANSCRIPTION_MODEL=openai/whisper-large-v3-turbo
DEEPINFRA_TEXT_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
DEEPINFRA_VISION_MODEL=Qwen/Qwen3-VL-235B-A22B-Instruct
DEEPINFRA_EMBEDDING_MODEL=BAAI/bge-m3
DEEPINFRA_TIMEOUT_MS=120000
TRANSCRIPTION_PROVIDER=auto
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_API_URL=
TRANSCRIPTION_ENABLED=
# Leave empty / "auto" for DeepInfra language detection. Explicit ISO codes force a language.
TRANSCRIPTION_LANGUAGE=auto
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
TRANSCRIPTION_TIMEOUT_MS=120000
REEL_WORKER_CONCURRENCY=3
REEL_FFMPEG_TIMEOUT_MS=120000
REEL_OCR_FRAME_INTERVAL_SEC=2
REEL_VISION_MAX_FRAMES=12
# Monthly AI spend cap (Europe/Berlin). Values are EUR after USD→EUR + tax + safety markup.
AI_BUDGET_MONTHLY_EUR=20
AI_BUDGET_WARN_EUR=10
AI_BUDGET_ENRICHMENT_PAUSE_EUR=15
AI_BUDGET_BACKGROUND_PAUSE_EUR=18
AI_BUDGET_USD_EUR=0.95
AI_BUDGET_FX_DATED=2026-03-01-manual
AI_BUDGET_TAX_FACTOR=1.19
AI_BUDGET_SAFETY_FACTOR=1.25
AI_BUDGET_PRICE_VERSION=deepinfra-2026-03-verified
AI_BUDGET_QUEUE_RESUME=manual
JEV_API_KEY=
TYPESAFE_API_KEY=
JEV_API_URL=
JEV_MODEL=
JEV_ENABLED=true
JEV_AUTO_ACTIONS_ENABLED=false
JEV_LLM_FALLBACK_ENABLED=false
JEV_TIMEOUT_MS=8000
REEL_ANALYSIS_MODEL=gpt-4o-mini
REEL_OCR_ENABLED=true
REEL_OCR_MODEL=gpt-4o-mini
# External web fact-check is a separate paid feature; keep off within the €20 budget.
REEL_FACTCHECK_ENABLED=false
REEL_FACTCHECK_MODEL=gpt-4.1-mini
AI_EMBEDDINGS_ENABLED=false

# Public build-time feature flags. These contain no credentials.
VITE_JEV_ENABLED=false
VITE_JEV_AUTO_ACTIONS_ENABLED=false

# Existing LifeOS developer console.
DEV_ADMIN_SECRET=
GITHUB_ADMIN_TOKEN=

# Daily compressed PostgreSQL dumps to R2.
BACKUP_CRON=15 3 * * *
BACKUP_RUN_ON_START=false
LOCAL_BACKUP_ROOT=/backups
